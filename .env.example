# Copy to .env locally (never commit .env). Secrets come from Partner Dashboard /
# /workspace/sellora/secrets/shopify-partner-app.env — do not paste real secrets into git.

APP_NAME=Sellora

# Public Client ID (safe to commit as an example value).
SHOPIFY_CLIENT_ID=7d912d414ddbffe0c1ff644b418efcf9

# Partner app Client Secret — leave blank in examples; set locally only.
SHOPIFY_API_SECRET=

# Public HTTPS base URL of this Rails app (no trailing slash). Partner App URL = $SHOPIFY_APP_URL/shopify
# Callback = $SHOPIFY_APP_URL/auth/shopify/callback. Localhost blanks Admin embed — use a tunnel/public host.
SHOPIFY_APP_URL=http://127.0.0.1:3000

# Wave 1 allowed scopes: Phase A catalog reads + pixel activation (no read_orders / write_products).
SHOPIFY_SCOPES=read_products,read_inventory,read_locations,write_pixels,read_customer_events

# Admin API version used by later sync code (OAuth itself is version-agnostic).
SHOPIFY_API_VERSION=2025-10

# Active Record encryption keys for Shop#access_token (and future secrets at rest).
# Generate locally (do not commit real values):
#   bin/rails db:encryption:init
# Then copy the three values into your private .env / secret store.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# HTTP Basic for /demo and /app (fictional in-app demo). Required to view demo findings/catalog.
# Leave blank locally only if you accept 503 Service Unavailable on those routes.
DEMO_HTTP_BASIC_USER=demo
DEMO_HTTP_BASIC_PASSWORD=change-me

# Shared secret for POST /web_pixels/events (web pixel ingest stub).
# Generate a long random value locally; never commit the real secret.
# Storefront cannot hold this safely — Wave 1 stub only; app proxy later.
WEB_PIXEL_INGEST_SECRET=
