<div class="page-heading"><div><h1>Orders</h1><p class="muted">Payment and fulfillment outcomes mirrored from Shopify.</p></div><%= link_to "Manage orders in Shopify ↗", shopify_admin_url(@shop_record, "orders"), class: "button primary", target: "_top" %></div>
<section class="card table-wrap"><table><thead><tr><th>Order</th><th>Date</th><th>Total</th><th>Payment</th><th>Fulfillment</th><th>Products</th></tr></thead><tbody>
  <% @orders.each do |order| %><tr><td><strong><%= order.name %></strong></td><td><%= order.processed_at&.to_date || "—" %></td><td><%= order.currency %> <%= number_with_precision(order.total_price, precision: 2) %></td><td><span class="badge neutral"><%= order.financial_status.presence&.titleize || "Unknown" %></span></td><td><%= order.fulfillment_status.presence&.titleize || "Unknown" %></td><td><%= order.commerce_order_lines.sum(&:quantity) %> items</td></tr><% end %>
  <% if @orders.blank? %><tr><td colspan="6" class="empty">No orders have been mirrored.</td></tr><% end %>
</tbody></table></section><div class="callout" style="margin-top:1rem">COD gateway status does not prove delivery or cash collection. Courier or ERP delivery and remittance data is required for that outcome.</div>
