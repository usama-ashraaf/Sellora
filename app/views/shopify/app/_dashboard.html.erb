<header class="topbar"><div class="brand"><span class="brand-mark">S</span><div><strong>Sellora</strong><small>Commerce intelligence</small></div></div><% if @shop_record&.installed? %><div class="connection"><span class="connection-dot"></span><%= @shop_record.shopify_domain %></div><% end %></header>
<% if @shop_record&.installed? %>
  <nav class="nav" aria-label="Sellora dashboard"><% Shopify::AppController::SECTIONS.each do |section| %><%= link_to section.titleize, shopify_embedded_app_path(shop: @shop_domain, host: @host, section: section), class: (@section == section ? "active" : nil), aria: { current: (@section == section ? "page" : nil) } %><% end %></nav>
  <main><%= render "shopify/app/#{@section}" %></main>
<% else %>
  <main><div class="card empty"><h1>Connect Sellora</h1><p>This store is not currently connected.</p><div class="actions" style="justify-content:center"><%= link_to "Install or repair connection", shopify_install_path(shop: @shop_domain), class: "button primary", target: "_top" %></div></div></main>
<% end %>
