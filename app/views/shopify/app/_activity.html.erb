<div class="page-heading"><div><h1>Activity</h1><p class="muted">Consent-limited storefront events received by Sellora.</p></div></div>
<div class="grid metrics"><% { "Product views" => "product_viewed", "Cart adds" => "product_added_to_cart", "Checkouts" => "checkout_started", "Completed" => "checkout_completed" }.each do |label, event_name| %><div class="card"><div class="metric-label"><%= label %></div><div class="metric-value"><%= @commerce_signals[:funnel][event_name] %></div><div class="metric-note">Last 7 days</div></div><% end %></div>
<section class="card"><div class="section-head"><h2>Recent storefront events</h2><span class="muted">Latest <%= @recent_events.size %></span></div><ul class="list"><% @recent_events.each do |event| %><li><div class="status-line"><strong><%= event.event_name.titleize %></strong><span class="muted"><%= time_ago_in_words(event.occurred_at) %> ago</span></div><% if event.payload["product_id"].present? %><small class="muted">Product <%= event.payload["product_id"] %></small><% end %></li><% end %><% if @recent_events.blank? %><li class="empty">No consented storefront events received.</li><% end %></ul></section>
